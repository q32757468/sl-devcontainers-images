{
    "herdr": {
        "image": "ubuntu:noble",
        "remoteUser": "ubuntu",
        // apt-source must precede common-utils:2 for its apt-based package installation.
        // common-utils:2 provides curl/wget used by the Herdr installer.
        "features": {
            "apt-source": {},
            "ghcr.nju.edu.cn/devcontainers/features/common-utils:2": {},
            "utils": {},
            "patch-node": {},
            "ghcr.nju.edu.cn/devcontainers/features/node:2": {
                "version": "24",
                "pnpmVersion": "none",
                "nodeGypDependencies": false
            },
            "pnpm": {},
            "herdr": {
                "githubMirror": "https://gh.hihsl.cn/"
            }
        },
        // Keep apt-source before common-utils:2.
        "overrideFeatureInstallOrder": [
            "./apt-source",
            "ghcr.nju.edu.cn/devcontainers/features/common-utils:2",
            "./utils",
            "./patch-node",
            "ghcr.nju.edu.cn/devcontainers/features/node:2",
            "./pnpm",
            "./herdr"
        ]
    }
}
