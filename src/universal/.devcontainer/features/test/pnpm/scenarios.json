{
    "pnpm": {
        "image": "ubuntu:noble",
        "remoteUser": "ubuntu",
        // Intentionally independent: the Node Feature provides the prerequisites.
        "features": {
            "utils": {},
            "patch-node": {},
            "ghcr.nju.edu.cn/devcontainers/features/node:2": {
                "version": "24",
                "pnpmVersion": "none",
                "nodeGypDependencies": false
            },
            "pnpm": {}
        },
        "overrideFeatureInstallOrder": [
            "./utils",
            "./patch-node",
            "ghcr.nju.edu.cn/devcontainers/features/node:2",
            "./pnpm"
        ]
    }
}
