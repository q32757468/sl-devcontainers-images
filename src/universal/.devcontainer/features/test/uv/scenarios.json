{
    "uv": {
        "image": "ubuntu:noble",
        "remoteUser": "ubuntu",
        // Intentionally independent: the Python Feature installs the prerequisites.
        "features": {
            "ghcr.nju.edu.cn/devcontainers/features/python:1": {
                "version": "os-provided",
                "useOryxIfAvailable": "false",
                "installTools": false
            },
            "utils": {},
            "uv": {
                "githubMirror": "https://gh.hihsl.cn/"
            }
        },
        "overrideFeatureInstallOrder": [
            "ghcr.nju.edu.cn/devcontainers/features/python:1",
            "./utils",
            "./uv"
        ]
    }
}
