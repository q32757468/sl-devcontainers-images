{
    "id": "claude-code",
    "version": "1.0.0",
    "name": "Claude Code",
    "installsAfter": [
        "./utils",
        "./pnpm"
    ],
    "options": {
        "cacheBuster": {
            "type": "string",
            "default": "",
            "description": "Change this value to force a fresh Claude Code installation during image builds."
        }
    },
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/tmp/claude-host",
            "type": "bind"
        }
    ],
    "onCreateCommand": [
        "/usr/local/share/devcontainer-features/utils/link-persistent-directory.sh",
        "config",
        ".claude"
    ],
    "postCreateCommand": [
        "/usr/local/share/devcontainer-features/claude-code/post-create.sh"
    ],
    "postStartCommand": [
        "/usr/local/share/devcontainer-features/claude-code/post-start.sh"
    ]
}
