{
    "id": "codex",
    "version": "1.0.0",
    "name": "Codex",
    "installsAfter": [
        "./utils",
        "./pnpm"
    ],
    "options": {
        "githubMirror": {
            "type": "string",
            "default": "https://gh.hihsl.cn/",
            "description": "URL prefix used to accelerate downloads from GitHub. Set to an empty string to download directly."
        },
        "cacheBuster": {
            "type": "string",
            "default": "",
            "description": "Change this value to force a fresh Codex installation during image builds."
        }
    },
    "onCreateCommand": [
        "/usr/local/share/devcontainer-features/utils/link-persistent-directory.sh",
        "config",
        ".codex"
    ],
    "postCreateCommand": [
        "/usr/local/share/devcontainer-features/codex/post-create.sh"
    ]
}
