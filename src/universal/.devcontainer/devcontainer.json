{
    "build": {
        "dockerfile": "./Dockerfile",
        "context": "."
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "username": "hsl",
            "userUid": "1000",
            "userGid": "1000",
            "installZsh": false,
            "installOhMyZsh": false,
            "installOhMyZshConfig": false,
            "upgradePackages": false
        },
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24",
            "additionalVersions": "22",
            "npmVersion": "latest",
            "pnpmVersion": "none"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "os-provided",
            "useOryxIfAvailable": "false",
            "installTools": false
        },
        "./local-features/uv": "latest",
        "./local-features/rust": "latest",
        "./local-features/utils": "latest",
        "./local-features/pnpm": {
            "cacheBuster": "1"
        },
        "./local-features/agent-skills": "latest",
        "./local-features/patch-node": "latest",
        "./local-features/patch-python": "latest",
        "./local-features/claude-code": {
            "cacheBuster": "1.5"
        },
        "./local-features/codex": {
            "cacheBuster": "1.5"
        }
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/python",
        "./local-features/rust",
        "./local-features/utils",
        "./local-features/pnpm",
        "./local-features/uv",
        "./local-features/agent-skills",
        "./local-features/claude-code",
        "./local-features/codex",
        "./local-features/patch-node",
        "./local-features/patch-python"
    ],
    "remoteUser": "hsl",
    "containerUser": "hsl",
    "customizations": {
        "vscode": {
            "extensions": [
                "-dbaeumer.vscode-eslint",
                "eamodio.gitlens",
                "esbenp.prettier-vscode",
                "chrisvltn.log-wrapper-for-vscode"
            ]
        }
    }
}
