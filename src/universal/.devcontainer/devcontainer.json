{
    "build": {
        "dockerfile": "./Dockerfile",
        "context": "."
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh/agent.sock,target=/tmp/ssh-agent.sock,type=bind"
    ],
    "remoteEnv": {
        // 使用 remoteEnv 而不是 containerEnv 防止出现基于变量名的安全警告，实际无风险
        "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "username": "hsl",
            "userUid": "1000",
            "userGid": "1000",
            "installZsh": false,
            "installOhMyZsh": false,
            "installOhMyZshConfig": false,
            "upgradePackages": false
        },
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24",
            "additionalVersions": "22",
            "npmVersion": "latest",
            "pnpmVersion": "none"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "os-provided",
            "useOryxIfAvailable": "false",
            "installTools": false
        },
        "./local-features/uv": "latest",
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "stable",
            "profile": "complete"
        },
        "./local-features/pnpm": "latest",
        "./local-features/agent-skills": "latest",
        "./local-features/patch-node": "latest",
        "./local-features/patch-python": "latest",
        "./local-features/claude-code": {
            "cacheBuster": "1.5"
        },
        "./local-features/codex": {
            "cacheBuster": "1.5"
        }
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/devcontainers/features/rust",
        "./local-features/pnpm",
        "./local-features/uv",
        "./local-features/agent-skills",
        "./local-features/claude-code",
        "./local-features/codex",
        "./local-features/patch-node",
        "./local-features/patch-python"
    ],
    "remoteUser": "hsl",
    "containerUser": "hsl",
    "customizations": {
        "vscode": {
            "extensions": [
                "-dbaeumer.vscode-eslint",
                "eamodio.gitlens",
                "esbenp.prettier-vscode",
                "chrisvltn.log-wrapper-for-vscode"
            ]
        }
    }
}
