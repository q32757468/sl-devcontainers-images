{
    "build": {
        "dockerfile": "./Dockerfile",
        "context": "."
    },
    "features": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24",
            "additionalVersions": "22",
            "npmVersion": "latest",
            "pnpmVersion": "none"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12",
            "useOryxIfAvailable": "false"
        },
        "./local-features/pnpm": "latest",
        "./local-features/uv": "latest",
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "stable",
            "profile": "complete"
        }
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers/features/node",
        "./local-features/pnpm",
        "ghcr.io/devcontainers/features/python",
        "./local-features/uv",
        "ghcr.io/devcontainers/features/rust"
    ],
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/tmp/claude-host,type=bind,readonly"
    ],
    "postStartCommand": "mkdir -p /home/hsl/.claude && cp --update=none /tmp/claude-host/settings.json /home/hsl/.claude/settings.json",
    "remoteUser": "hsl",
    "containerUser": "hsl",
    "customizations": {
        "vscode": {
            "extensions": [
                "-dbaeumer.vscode-eslint",
                "eamodio.gitlens",
                "esbenp.prettier-vscode",
                "chrisvltn.log-wrapper-for-vscode"
            ]
        }
    }
}