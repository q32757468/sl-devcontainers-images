{
    "build": {
        "dockerfile": "./Dockerfile",
        "context": "."
    },
    "features": {
        "./features/src/apt-source": "latest",
        "ghcr.nju.edu.cn/devcontainers/features/common-utils:2": {
            "username": "${localEnv:LOGNAME}",
            "userUid": "1000",
            "userGid": "1000",
            "installZsh": false,
            "installOhMyZsh": false,
            "installOhMyZshConfig": false,
            "upgradePackages": false
        },
        "ghcr.nju.edu.cn/devcontainers/features/node:2": {
            "version": "24",
            "additionalVersions": "22",
            "npmVersion": "latest",
            "pnpmVersion": "none"
        },
        "ghcr.nju.edu.cn/devcontainers/features/python:1": {
            "version": "os-provided",
            "useOryxIfAvailable": "false",
            "installTools": false
        },
        "./features/src/uv": "latest",
        "./features/src/rust": "latest",
        "./features/src/tauri-deps": "latest",
        "./features/src/utils": "latest",
        "./features/src/pnpm": {
            "cacheBuster": "1"
        },
        "./features/src/agent-skills": "latest",
        "./features/src/github-cli": "latest",
        "./features/src/patch-node": "latest",
        "./features/src/patch-python": "latest",
        "./features/src/herdr": {
            "cacheBuster": "1.2"
        },
        "./features/src/antigravity": {
            "cacheBuster": "1.1"
        },
        "./features/src/claude-code": {
            "cacheBuster": "1.6"
        },
        "./features/src/codex": {
            "cacheBuster": "1.5"
        },
        "./features/src/vscode": "latest"
    },
    "overrideFeatureInstallOrder": [
        "./features/src/apt-source",
        "ghcr.nju.edu.cn/devcontainers/features/common-utils",
        "./features/src/utils",
        "./features/src/patch-node",
        "ghcr.nju.edu.cn/devcontainers/features/node",
        "./features/src/patch-python",
        "ghcr.nju.edu.cn/devcontainers/features/python",
        "./features/src/uv",
        "./features/src/rust",
        "./features/src/tauri-deps",
        "./features/src/pnpm",
        "./features/src/agent-skills",
        "./features/src/github-cli",
        "./features/src/herdr",
        "./features/src/antigravity",
        "./features/src/claude-code",
        "./features/src/codex",
        "./features/src/vscode"
    ],
    "remoteUser": "${localEnv:LOGNAME}",
    "containerUser": "${localEnv:LOGNAME}",
    "mounts": [
        "source=sl-config,target=/home/${localEnv:LOGNAME}/.sl-config,type=volume",
        "source=sl-cache,target=/home/${localEnv:LOGNAME}/.sl-cache,type=volume"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "-dbaeumer.vscode-eslint",
                "-ms-python.autopep8",
                "charliermarsh.ruff",
                "eamodio.gitlens",
                "esbenp.prettier-vscode",
                "chrisvltn.log-wrapper-for-vscode",
                "rust-lang.rust-analyzer",
                "32757468.attentive-vscode"
            ]
        }
    }
}