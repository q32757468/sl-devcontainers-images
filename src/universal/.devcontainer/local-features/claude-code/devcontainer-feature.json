{
    "id": "claude-code",
    "version": "1.0.0",
    "name": "Claude Code",
    "installsAfter": [
        "./local-features/pnpm"
    ],
    "options": {
        "cacheBuster": {
            "type": "string",
            "default": "",
            "description": "Change this value to force a fresh Claude Code installation during image builds."
        }
    },
    "mounts": [
        // readonly 只有字符串形式支持，虽然schema上显示不支持，但是实际是支持字符串形式
        "source=${localEnv:HOME}/.claude,target=/tmp/claude-host,type=bind,readonly",
        {
            "source": "claude-code-config",
            "target": "${localEnv:HOME}/.claude",
            "type": "volume"
        }
    ],
    "postCreateCommand": [
        "/usr/local/share/devcontainer-features/claude-code/post-create.sh"
    ],
    "postStartCommand": [
        "/usr/local/share/devcontainer-features/claude-code/post-start.sh"
    ]
}
