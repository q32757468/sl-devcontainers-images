{
    "id": "user",
    "version": "1.0.0",
    "name": "Non-root user",
    "description": "Create the non-root container user with passwordless sudo",
    "options": {
        "username": {
            "type": "string",
            "default": "codespace",
            "description": "Username for the non-root user"
        },
        "userUid": {
            "type": "string",
            "default": "1000",
            "description": "UID for the non-root user"
        },
        "userGid": {
            "type": "string",
            "default": "1000",
            "description": "GID for the non-root user"
        }
    }
}
