{
    "id": "codex",
    "version": "1.0.0",
    "name": "Codex",
    "installsAfter": [
        "./local-features/pnpm"
    ],
    "options": {
        "cacheBuster": {
            "type": "string",
            "default": "",
            "description": "Change this value to force a fresh Codex installation during image builds."
        }
    },
    "mounts": [
        // readonly 只有字符串形式支持，虽然schema上显示不支持，但是实际是支持字符串形式
        "source=${localEnv:HOME}/.codex,target=/tmp/codex-host,type=bind,readonly",
        {
            "source": "codex-config",
            "target": "${localEnv:HOME}/.codex",
            "type": "volume"
        }
    ],
    "postStartCommand": "sudo chown -R $(id -u):$(id -g) $HOME/.codex\nmkdir -p $HOME/.codex\n[ -f /tmp/codex-host/auth.json ] && cp /tmp/codex-host/auth.json $HOME/.codex/auth.json"
}
