{
    "id": "codex",
    "version": "1.0.0",
    "name": "Codex",
    "installsAfter": [
        "./local-features/pnpm"
    ],
    "options": {
        "cacheBuster": {
            "type": "string",
            "default": "",
            "description": "Change this value to force a fresh Codex installation during image builds."
        }
    },
    "mounts": [
        // readonly 只有字符串形式支持，虽然schema上显示不支持，但是实际是支持字符串形式
        "source=${localEnv:HOME}/.codex,target=/tmp/codex-host,type=bind,readonly",
        {
            "source": "codex-config",
            "target": "/home/${localEnv:LOGNAME}/.codex",
            "type": "volume"
        }
    ],
    "postStartCommand": [
        "/usr/local/share/devcontainer-features/codex/post-start.sh"
    ]
}
